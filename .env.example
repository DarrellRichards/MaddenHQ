# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://maddenhq:maddenhq@localhost:5432/maddenhq?schema=public

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Local/dev credentials login (enabled when NODE_ENV !== production or ENABLE_DEV_LOGIN=true)
ENABLE_DEV_LOGIN=true
DEV_LOGIN_EMAIL=dev@maddenhq.local
DEV_LOGIN_PASSWORD=maddenhq-dev

# Token encryption for EA credentials at rest (32+ char secret)
EA_TOKEN_ENCRYPTION_KEY=replace-with-long-random-secret-key!!

# EA sync (unofficial; experimental)
EA_SYNC_ENABLED=false
EA_CLIENT_MODE=stub

# Donations
NEXT_PUBLIC_GITHUB_SPONSORS_URL=https://github.com/sponsors/DarrellRichards
STRIPE_DONATION_URL=

# AI (unused until awards/trade engines ship)
OPENAI_API_KEY=
