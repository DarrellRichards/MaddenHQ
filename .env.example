DEV_LOGIN_PASSWORD=maddenhq-dev

# Token encryption for EA credentials at rest (32+ char secret)
EA_TOKEN_ENCRYPTION_KEY=replace-with-long-random-secret-key!!

# EA sync (unofficial Companion / Blaze API — see docs/ea-sync.md)
EA_CLIENT_MODE=stub
# live | stub  — use live only with real EA credentials
